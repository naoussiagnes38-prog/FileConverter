<UserControl x:Class="FileConverter.Controls.OutputLocationPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource PrimaryTextBrush}">
    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="7" Padding="12">
        <StackPanel>
            <TextBlock Text="{DynamicResource L_Output_Location}" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <RadioButton x:Name="OriginalFolder" IsChecked="True" Margin="0,0,0,6"
                         Content="{DynamicResource L_Save_in_the_same_folder_as_the_original_files}"
                         Foreground="{DynamicResource PrimaryTextBrush}"/>
            <RadioButton x:Name="CustomFolder"
                         Content="{DynamicResource L_Save_in_another_folder}"
                         Foreground="{DynamicResource PrimaryTextBrush}"/>
            <DockPanel Margin="0,8,0,0" IsEnabled="{Binding IsChecked, ElementName=CustomFolder}">
                <Button DockPanel.Dock="Right" Content="{DynamicResource L_Browse}"
                        Click="Browse_Click" Margin="8,0,0,0"/>
                <TextBox x:Name="FolderPath" IsReadOnly="True" Padding="8,5"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                         AutomationProperties.Name="{DynamicResource L_Output_Location}"/>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
