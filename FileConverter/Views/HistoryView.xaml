<UserControl x:Class="FileConverter.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="850"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>

        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>

        <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,14"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedItemBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="5">

            <!-- HEADER -->
            <StackPanel Margin="0,0,0,25">

                <TextBlock Text="{DynamicResource L_Operation_History}"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <TextBlock Text="{DynamicResource L_Track_your_previous_file_operations}"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,7,0,0"/>

            </StackPanel>

            <!-- SUMMARY CARDS -->
            <Grid Margin="0,0,0,25">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_TOTAL_OPERATIONS}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="TotalCount"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_SUCCESSFUL}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="SuccessCount"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource SummaryCard}"
                        Margin="0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_FAILED}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="FailureCount"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ErrorTextBrush}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- SEARCH AND FILTERS -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,0,0,15">

                <StackPanel>

                    <TextBlock Text="{DynamicResource L_Search_history}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,10"/>

                    <TextBox x:Name="SearchTextBox"
                             MinHeight="38"
                             Padding="10,8"
                             FontSize="14"
                             AutomationProperties.Name="{DynamicResource L_Search_history}"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}"
                             TextChanged="SearchTextBox_TextChanged"/>

                    <TextBlock Text="{DynamicResource L_FILTER_BY_STATUS}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,20,0,10"/>

                    <WrapPanel>

                        <Button x:Name="AllFilterButton"
                                Content="{DynamicResource L_All}"
                                Tag="All"
                                Style="{StaticResource FilterButton}"
                                Click="FilterButton_Click"/>

                        <Button x:Name="CompletedFilterButton"
                                Content="{DynamicResource L_Completed}"
                                Tag="Completed"
                                Style="{StaticResource FilterButton}"
                                Click="FilterButton_Click"/>

                        <Button x:Name="FailedFilterButton"
                                Content="{DynamicResource L_Failed}"
                                Tag="Failed"
                                Style="{StaticResource FilterButton}"
                                Click="FilterButton_Click"/>

                        

                    </WrapPanel>

                </StackPanel>
            </Border>

            <!-- HISTORY TABLE -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="15">

                <StackPanel>

                    <DockPanel Margin="5,0,5,15">

                        <TextBlock Text="{DynamicResource L_Recent_operations}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>

                        

                    </DockPanel>

                    <DataGrid x:Name="HistoryDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              Background="{DynamicResource CardBackgroundBrush}"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderThickness="0"
                              MinRowHeight="40"
                              ColumnHeaderHeight="40"
                              MaxHeight="360"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="FILE NAME" Binding="{Binding FileName}" Width="*" MinWidth="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Margin" Value="6,5"/>
                                        <Setter Property="ToolTip" Value="{Binding FileName}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="155"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding DisplayStatus}" Width="110"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <TextBlock Text="{DynamicResource L_No_matching_history_records}"
                               Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" Margin="0,16,0,5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=HistoryDataGrid}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Margin="0,14,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem, ElementName=HistoryDataGrid}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{DynamicResource L_INPUT_PATH}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBox Text="{Binding SelectedItem.DisplayInput, ElementName=HistoryDataGrid, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" Padding="8,6" Margin="0,4,0,9"
                                 AutomationProperties.Name="{DynamicResource L_INPUT_PATH}"/>
                        <TextBlock Text="{DynamicResource L_OUTPUT_PATH}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBox Text="{Binding SelectedItem.DisplayOutput, ElementName=HistoryDataGrid, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" Padding="8,6" Margin="0,4,0,0"
                                 AutomationProperties.Name="{DynamicResource L_OUTPUT_PATH}"/>
                    </StackPanel>

                </StackPanel>

            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
