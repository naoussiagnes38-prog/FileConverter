<UserControl x:Class="FileConverter.Views.TranslateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FileConverter.Controls"
             Background="{DynamicResource WindowBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">

            <TextBlock Text="{DynamicResource L_Document_Translation}"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,7"/>

            <TextBlock Text="{DynamicResource L_Translate_English_and_French_documents_to_plain_text_using_a_local_LibreTranslate_server}"
                       FontSize="14"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"/>

        </StackPanel>

        <!-- LANGUAGE INFORMATION -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15">

            <StackPanel>

                <TextBlock Text="{DynamicResource L_Supported_languages}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal">

                    <Border Background="{DynamicResource SelectedItemBrush}"
                            CornerRadius="5"
                            Padding="12,6"
                            Margin="0,0,10,0">
                        <TextBlock Text="{DynamicResource L_English}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <TextBlock Text="↔"
                               FontSize="18"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <Border Background="{DynamicResource SelectedItemBrush}"
                            CornerRadius="5"
                            Padding="12,6">
                        <TextBlock Text="{DynamicResource L_French}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"/>
                    </Border>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- FILE UPLOAD AREA -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                AllowDrop="True"
                DragEnter="FileDrop_DragEnter"
                DragOver="FileDrop_DragOver"
                Drop="FileDrop_Drop">

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock Text="⇧"
                           FontSize="35"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>

                <TextBlock Text="{DynamicResource L_Add_TXT_DOCX_RTF_or_text_based_PDF_documents}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>

                <TextBlock Text="{DynamicResource L_Drag_and_drop_your_documents_here}"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <Button Content="{DynamicResource L_Browse_files}"
                        Width="130"
                        Height="34"
                        Background="{DynamicResource ActionBackgroundBrush}"
                        Foreground="{DynamicResource ActionTextBrush}"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="BrowseFiles_Click"/>

            </StackPanel>

        </Border>

        <!-- DOCUMENT QUEUE -->
        <Grid Grid.Row="3" Margin="0,18,0,10" MinHeight="110" MaxHeight="350">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{DynamicResource L_Selected_documents}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="FileCountText"
                           Grid.Column="1"
                           Text="{DynamicResource L_0_documents}"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>

            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                <Grid>

                    <TextBlock x:Name="EmptyQueueText"
                               Text="{DynamicResource L_No_documents_added_yet}"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl x:Name="FilesList">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="12">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">

                                                <TextBlock Text="{Binding FileName}" ToolTip="{Binding FullPath}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{Binding FileInformation}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,4,0,0"/>

                                                <WrapPanel Margin="0,7,0,0">

                                                    <TextBlock Text="{DynamicResource L_Language}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                                    <TextBlock Text="{Binding DetectedLanguage}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               Margin="0,0,15,0"/>

                                                    <TextBlock Text="{DynamicResource L_Direction}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                                    <TextBlock Text="{Binding TranslationDirection}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                                </WrapPanel>

                                                <ComboBox Margin="0,8,0,0" Width="190"
                                                          HorizontalAlignment="Left"
                                                          SelectedValuePath="Tag"
                                                          SelectedValue="{Binding TargetLanguage, Mode=TwoWay}"
                                                          AutomationProperties.Name="{DynamicResource L_Direction}">
                                                    <ComboBoxItem Tag="" Content="{DynamicResource L_Automatic_direction}"/>
                                                    <ComboBoxItem Tag="en" Content="{DynamicResource L_French_English}"/>
                                                    <ComboBoxItem Tag="fr" Content="{DynamicResource L_English_French}"/>
                                                </ComboBox>

                                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Margin="0,5,0,0"/>

                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="{DynamicResource L_Remove}"
                                                    Tag="{Binding FullPath}"
                                                    Padding="10,6"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource SurfaceBackgroundBrush}"
                                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    Cursor="Hand"
                                                    Click="RemoveFile_Click"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>

            </Border>

        </Grid>

        <StackPanel Grid.Row="4" Margin="0,0,0,6">
            <TextBlock x:Name="TranslationNotice" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource ErrorTextBrush}" Margin="0,0,0,5"/>
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                <TextBlock x:Name="ProgressLabel" TextWrapping="Wrap" Margin="0,0,0,5"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" MinWidth="40" TextAlignment="Right"
                               FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding Value, ElementName=DocumentProgress, StringFormat={}{0:0}%}"/>
                    <ProgressBar x:Name="DocumentProgress" Height="8" Maximum="100" VerticalAlignment="Center"
                                 AutomationProperties.Name="{DynamicResource L_Overall_progress}"/>
                </DockPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,6,0,0">
            <controls:OutputLocationPicker x:Name="OutputLocation" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource L_Output_format}" VerticalAlignment="Center"
                           Margin="0,0,8,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <ComboBox x:Name="TranslationOutputFormat" Width="140" SelectedIndex="0" SelectedValuePath="Tag"
                          AutomationProperties.Name="{DynamicResource L_Output_format}">
                    <ComboBoxItem Content="TXT" Tag="txt"/>
                    <ComboBoxItem Content="PDF" Tag="pdf"/>
                    <ComboBoxItem Content="Word (DOCX)" Tag="docx"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- BOTTOM ACTIONS -->
        <Grid Grid.Row="6" Margin="0,10,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="{DynamicResource L_Clear_all}"
                    Padding="16,9"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Cursor="Hand"
                    Click="ClearFiles_Click"/>

            <Button Grid.Column="1"
                    Content="{DynamicResource L_Translate_documents}"
                    Padding="18,9"
                    Background="{DynamicResource ActionBackgroundBrush}"
                    Foreground="{DynamicResource ActionTextBrush}"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="TranslateFiles_Click"/>

        </Grid>

    </Grid>
    </ScrollViewer>

</UserControl>