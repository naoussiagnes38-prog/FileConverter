<UserControl x:Class="FileConverter.Views.EncryptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             MinWidth="0">

    <UserControl.Resources>

        <!-- PRIMARY ACTION BUTTON -->

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"
                    Value="{DynamicResource ActionBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ActionTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- SECONDARY BUTTON -->

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"
                    Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- SECTION TITLE -->

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="30">

            <!-- HEADER -->

            <TextBlock Text="{DynamicResource L_Encrypt_or_decrypt_files}"
                       FontSize="27"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <TextBlock Text="{DynamicResource L_Protect_files_or_restore_FileConverter_encrypted_files}"
                       FontSize="13"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,6,0,25"/>

            <!-- FILE UPLOAD -->

            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="{DynamicResource L_Select_Files}"
                               Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="{DynamicResource L_Add_the_files_you_want_to_process}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               Margin="0,0,0,15"/>

                    <!-- DROP ZONE -->

                    <Border x:Name="DropZone"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="25"
                            AllowDrop="True"
                            DragOver="DropZone_DragOver"
                            Drop="DropZone_Drop">

                        <StackPanel HorizontalAlignment="Center">

                            <TextBlock Text="&#xE72E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="35"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{DynamicResource L_Drag_and_drop_files_here}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <TextBlock Text="{DynamicResource L_or}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,5"/>

                            <Button Content="{DynamicResource L_Browse_Files}"
                                    Style="{StaticResource ActionButton}"
                                    Click="ChooseFiles_Click"
                                    HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                    <!-- SELECTED FILES HEADER -->

                    <DockPanel Margin="0,20,0,10">

                        <TextBlock Text="{DynamicResource L_Selected_Files}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="ClearAllButton"
                                Content="{DynamicResource L_Clear_All}"
                                Style="{StaticResource SecondaryButton}"
                                Click="ClearAll_Click"
                                DockPanel.Dock="Right"/>

                    </DockPanel>

                    <TextBlock x:Name="FileCountText"
                               Text="{DynamicResource L_0_files_selected}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="EmptyListText"
                               Text="{DynamicResource L_No_files_selected_yet}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Padding="15"/>

                    <!-- FILE LIST -->

                    <ItemsControl x:Name="FileList">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,7">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">

                                            <TextBlock Text="{Binding FileName}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                                            <TextBlock Text="{Binding FilePath}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>

                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="{DynamicResource L_Remove}"
                                                Tag="{Binding FilePath}"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="RemoveFile_Click"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </Border>

            <!-- ENCRYPTION SETTINGS -->

            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="{DynamicResource L_Encryption_Settings}"
                               Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="{DynamicResource L_Configure_how_your_files_will_be_protected}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,18"/>

                    <!-- ALGORITHM -->

                    <TextBlock Text="{DynamicResource L_Encryption_Algorithm}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,7"/>

                    <ComboBox x:Name="EncryptionAlgorithmCombo"
                              Height="36"
                              SelectedIndex="0"
                              Padding="8"
                              Background="{DynamicResource InputBackgroundBrush}"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource InputBorderBrush}">

                        <ComboBoxItem Content="AES-256"/>

                    </ComboBox>

                    <!-- PASSWORD -->

                    <TextBlock Text="{DynamicResource L_Password}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,18,0,7"/>

                    <PasswordBox x:Name="EncryptionPasswordBox"
                                 Height="38"
                                 Padding="8"
                                 MaxLength="256"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}"/>

                    <!-- CONFIRM PASSWORD -->

                    <TextBlock Text="{DynamicResource L_Confirm_password_encryption_only}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,18,0,7"/>

                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 Height="38"
                                 Padding="8"
                                 MaxLength="256"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}"/>

                    <TextBlock Text="{DynamicResource L_Use_a_strong_password_and_keep_it_somewhere_safe_You_will_need_it_to_decrypt_your_files}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

            <!-- OUTPUT SETTINGS -->

            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="{DynamicResource L_Output_Settings}"
                               Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="{DynamicResource L_Choose_where_to_save_processed_files}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,15"/>

                    <RadioButton x:Name="SameFolderRadio"
                                 Content="{DynamicResource L_Save_in_the_original_file_location}"
                                 IsChecked="True"
                                 Margin="0,5"
                                 Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <RadioButton x:Name="CustomFolderRadio"
                                 Content="{DynamicResource L_Save_in_a_different_folder}"
                                 Margin="0,5"
                                 Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBox x:Name="OutputFolderTextBox"
                             IsReadOnly="True"
                             Height="35"
                             Margin="0,12,0,8"
                             Padding="8"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}"/>

                    <Button x:Name="BrowseFolderButton"
                            Content="{DynamicResource L_Browse_Folder}"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left"
                            IsEnabled="False"
                            Click="BrowseFolder_Click"/>

                    

                </StackPanel>

            </Border>

            <!-- ENCRYPTION ACTION -->

            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">

                <StackPanel>

                    <TextBlock Text="{DynamicResource L_File_protection}"
                               Style="{StaticResource SectionTitle}"/>

                    <TextBlock x:Name="EncryptionStatusText"
                               Text="{DynamicResource L_Ready_to_encrypt}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               Margin="0,5,0,15"/>

                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" MinWidth="40" TextAlignment="Right"
                                   FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="{Binding Value, ElementName=OperationProgress, StringFormat={}{0:0}%}"/>
                        <ProgressBar x:Name="OperationProgress" Height="8" Maximum="100" VerticalAlignment="Center"
                                     AutomationProperties.Name="{DynamicResource L_Overall_progress}"/>
                    </DockPanel>

                    <Button x:Name="EncryptButton"
                            Content="{DynamicResource L_Encrypt_Files}"
                            Style="{StaticResource ActionButton}"
                            Click="EncryptButton_Click"
                            HorizontalAlignment="Stretch"/>
                    <Button Content="{DynamicResource L_Decrypt_Files}" Style="{StaticResource ActionButton}"
                            Margin="0,8,0,0" Click="DecryptButton_Click"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
